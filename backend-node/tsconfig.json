{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    "module": "commonjs",
    "target": "esnext",

    // 1. Keep default node type loading
    "types": ["node", "mocha"],

    // 2. Point typeRoots to node_modules AND your custom types folder
    "typeRoots": [
      "./node_modules/@types",
      "./src/types"
    ],

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "baseUrl": ".",
    // 3. Clean up paths (remove the "*" wildcard override)
    "paths": {
      "app/*": ["src/*"]
    },

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true
  },
  // 4. Ensure TS explicitly includes src where your code and declaration lives
  "include": ["src/**/*"]
}
